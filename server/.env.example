# ── Server ──────────────────────────────────────────────
PORT=4000
CORS_ORIGIN=http://localhost:5173,http://localhost:4173

# ── Database (PostgreSQL 15+) ───────────────────────────
# docker compose membaca POSTGRES_* dari file ini.
POSTGRES_USER=retalio
POSTGRES_PASSWORD=ganti-dengan-password-database-yang-kuat
POSTGRES_DB=retalio
# Backend saat ini dijalankan dari host; PostgreSQL di-bind ke 127.0.0.1.
# Jika API kelak dijalankan sebagai service Compose, ganti host ke "postgres".
DATABASE_URL=postgresql://retalio:ganti-dengan-password-database-yang-kuat@localhost:5432/retalio?schema=public

# ── Auth / JWT ──────────────────────────────────────────
# WAJIB: minimal 32 karakter, berbeda satu sama lain, dan bukan nilai contoh.
# Server menolak start bila belum diisi / masih memakai placeholder.
# Buat dengan: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=
JWT_REFRESH_EXPIRES_IN=7d

# ── NVIDIA NIM (model AI utama) ─────────────────────────
# Hosted: https://integrate.api.nvidia.com/v1
# Self-hosted NIM: http://localhost:8000/v1
NIM_BASE_URL=https://integrate.api.nvidia.com/v1
NIM_API_KEY=
NIM_MODEL=meta/llama-3.1-8b-instruct
# Opsional (OCR struk/invoice via vision):
NIM_VISION_MODEL=

# ── AI Gateway ──────────────────────────────────────────
# TTL cache jawaban slow-path (detik)
AI_CACHE_TTL_SECONDS=600

# ── OneSignal Push Notification (Web & Mobile Push) ─────
# Isi App ID (UUID) dan REST API Key dari dashboard.onesignal.com
# Juga dapat diatur langsung melalui panel Superadmin > Push & Broadcast.
ONESIGNAL_APP_ID=
ONESIGNAL_REST_API_KEY=
ONESIGNAL_SAFARI_WEB_ID=

# ── Paket: lama trial dan kuota AI (opsional) ───────────
# Bila dikosongkan dipakai nilai bawaan di bawah. Bilangan bulat; kuota 0 = AI mati.
# TRIAL_DAYS=14            lama trial pendaftar baru (hari, minimal 1)
# TRIAL_AI_QUOTA=1000      pertanyaan AI per bulan selama trial
# AI_QUOTA_BASIC=0         kuota bawaan paket berbayar saat dibuat/diganti dari panel superadmin
# AI_QUOTA_PLUS_AI=3000
# AI_QUOTA_CUSTOM=25000

# ── Produksi / keamanan ─────────────────────────────────
# NODE_ENV=production mewajibkan CORS_ORIGIN eksplisit (tanpa wildcard, https).
# NODE_ENV=production
# Di belakang reverse proxy/LB: jumlah hop proxy tepercaya, agar throttle & audit memakai IP klien asli.
# TRUST_PROXY=1
# Batas request per IP per menit (rute /auth/* punya batas sendiri yang lebih ketat).
# THROTTLE_LIMIT=300
# Batas body JSON (rute OCR memakai OCR_BODY_LIMIT untuk gambar base64).
# BODY_LIMIT=512kb
# OCR_BODY_LIMIT=12mb
# Sesi: umur token idle = JWT_REFRESH_EXPIRES_IN; umur maksimum sesi & jumlah sesi aktif per user.
# SESSION_MAX_DAYS=30
# MAX_SESSIONS_PER_USER=10

# ── Seed (npm run seed) ─────────────────────────────────
# Seed MENGHAPUS data tenant demo. Ditolak bila NODE_ENV=production kecuali ALLOW_DESTRUCTIVE_SEED=yes.
# Kata sandi akun seed: SEED_ADMIN_PASSWORD (semua akun) atau per akun
# SEED_SUPERADMIN_PASSWORD / SEED_OWNER_PASSWORD / SEED_MANAGER_PASSWORD / SEED_KELANA_PASSWORD.
# Di luar produksi, bila kosong dipakai default DEV (admin123 / ferry123). Di produksi, bila kosong
# kata sandi dibangkitkan acak dan dicetak sekali; nilai dari env minimal 12 karakter.
# ALLOW_DESTRUCTIVE_SEED=yes
