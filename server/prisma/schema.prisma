/// Refresh token per perangkat/sesi. Token mentah tidak pernah disimpan: hanya
/// HMAC-SHA256-nya. Setiap penggunaan merotasi token (usedAt terisi dan baris baru
/// dibuat dalam family yang sama); memakai ulang token yang sudah dirotasi
/// dianggap pencurian dan mencabut seluruh family.
model RefreshSession {
  id              String    @id @default(uuid())
  tenantId        String    @map("tenant_id")
  userId          String    @map("user_id")
  familyId        String    @map("family_id")
  tokenHash       String    @unique @map("token_hash")
  mfaVerified     Boolean   @default(false) @map("mfa_verified")
  expiresAt       DateTime  @map("expires_at")
  familyExpiresAt DateTime  @map("family_expires_at")
  usedAt          DateTime? @map("used_at")
  revokedAt       DateTime? @map("revoked_at")
  revokedReason   String?   @map("revoked_reason")
  ipAddress       String?   @map("ip_address")
  userAgent       String?   @map("user_agent")
  createdAt       DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, familyId])
  @@index([familyId])
  @@index([expiresAt])
  @@map("refresh_sessions")
}

/// Penghitung percobaan login gagal (per akun, per akun+IP, per IP). Kunci berupa
/// hash sehingga email/IP tidak tersimpan mentah. Dipakai bersama oleh semua
/// instance API sehingga lock tidak hilang saat restart atau dibalik load balancer.
model AuthAttempt {
  key         String    @id
  failures    Int       @default(0)
  windowStart DateTime  @default(now()) @map("window_start")
  lockedUntil DateTime? @map("locked_until")
  updatedAt   DateTime  @default(now()) @updatedAt @map("updated_at")

  @@index([updatedAt])
  @@map("auth_attempts")
}

/// Pengajuan calon klien dari formulir luar (Google Form) yang dikirim lewat webhook bertanda tangan.
/// Data tingkat platform (bukan milik tenant): hanya superadmin yang dapat membacanya. `answers` menyimpan
/// semua pertanyaan dan jawaban apa adanya; kolom kontak/usaha hanyalah hasil ekstraksi untuk daftar dan pencarian.
model IntakeSubmission {
  id             String    @id @default(uuid())
  source         String    @default("google_form")
  /// ID respons dari Google. Unik, supaya pengiriman ulang (retry skrip) tidak membuat data ganda.
  externalId     String    @unique @map("external_id")
  formId         String?   @map("form_id")
  submittedAt    DateTime  @map("submitted_at")
  contactName    String?   @map("contact_name")
  contactEmail   String?   @map("contact_email")
  contactPhone   String?   @map("contact_phone")
  businessType   String?   @map("business_type")
  employeeRange  String?   @map("employee_range")
  /// [{ question: string, answer: string | string[] }]
  answers        Json
  /// new | contacted | qualified | closed
  status         String    @default("new")
  notes          String    @default("")
  /// pending | done | skipped | failed
  analysisStatus String    @default("pending") @map("analysis_status")
  analysis       Json?
  analysisModel  String?   @map("analysis_model")
  analysisError  String?   @map("analysis_error")
  analyzedAt     DateTime? @map("analyzed_at")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  @@index([status, createdAt])
  @@index([createdAt])
  @@map("intake_submissions")
}

/// Data awal klien dari Google Form 2 (diisi setelah klien berlangganan), dikirim lewat webhook bertanda tangan yang sama
/// dengan pengajuan calon klien. Data tingkat platform: hanya superadmin yang dapat membacanya. `tenantId` hanya petunjuk
/// hasil pencocokan email akun (tanpa relasi), supaya tabel ini tidak menyentuh data tenant mana pun.
model OnboardingSubmission {
  id           String   @id @default(uuid())
  /// ID respons dari Google. Unik, supaya pengiriman ulang (retry skrip) tidak membuat data ganda.
  externalId   String   @unique @map("external_id")
  formId       String?  @map("form_id")
  submittedAt  DateTime @map("submitted_at")
  contactName  String?  @map("contact_name")
  contactEmail String?  @map("contact_email")
  contactPhone String?  @map("contact_phone")
  tenantId     String?  @map("tenant_id")
  /// [{ question: string, answer: string | string[] }]
  answers      Json
  /// new | in_progress | done
  status       String   @default("new")
  notes        String   @default("")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@index([status, createdAt])
  @@index([createdAt])
  @@map("onboarding_submissions")
}

/// Pelanggan newsletter dari formulir di footer halaman depan. Data tingkat platform (bukan milik tenant): hanya
/// superadmin yang dapat membacanya. `status` mengikuti persetujuan: pending (email dicatat, belum dikonfirmasi lewat
/// email), confirmed (sudah mengonfirmasi), unsubscribed (berhenti). Pengiriman email belum ada; konfirmasi menyusul.
model NewsletterSubscriber {
  id             String    @id @default(uuid())
  /// Huruf kecil dan sudah dirapikan. Unik, supaya satu alamat hanya punya satu baris.
  email          String    @unique
  /// pending | confirmed | unsubscribed
  status         String    @default("pending")
  source         String    @default("footer")
  /// Kapan pengunjung mengisi formulir dan menyetujui kalimat persetujuannya.
  consentAt      DateTime  @map("consent_at")
  confirmedAt    DateTime? @map("confirmed_at")
  unsubscribedAt DateTime? @map("unsubscribed_at")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  @@index([status, createdAt])
  @@map("newsletter_subscribers")
}
