model SalesTransaction {
  id                String        @id @default(uuid())
  tenantId          String        @map("tenant_id")
  companyId         String        @map("company_id")
  outletId          String?       @map("outlet_id")
  cashierId         String?       @map("cashier_id")
  customerId        String?       @map("customer_id")
  clientGeneratedId String        @map("client_generated_id")
  syncStatus        SyncStatus    @default(synced) @map("sync_status")
  clientTimestamp   DateTime      @map("client_timestamp")
  serverTimestamp   DateTime?     @map("server_timestamp")
  total             Decimal       @db.Decimal(14, 2)
  paymentMethod     PaymentMethod @map("payment_method")
  createdAt         DateTime      @default(now()) @map("created_at")

  tenant           Tenant                 @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  company          Company                @relation(fields: [tenantId, companyId], references: [tenantId, id], onDelete: Cascade)
  outlet           Outlet?                @relation(fields: [outletId], references: [id], onDelete: SetNull)
  cashier          User?                  @relation(fields: [cashierId], references: [id], onDelete: SetNull)
  customer         Customer?              @relation(fields: [tenantId, companyId, customerId], references: [tenantId, companyId, id], onDelete: Restrict)
  items            SalesTransactionItem[]
  customerInvoices CustomerInvoice[]
  complaints       CustomerComplaint[]

  @@unique([tenantId, companyId, clientGeneratedId])
  @@index([tenantId, clientTimestamp])
  @@index([tenantId, syncStatus])
  @@map("sales_transactions")
}

model SalesTransactionItem {
  id            String  @id @default(uuid())
  transactionId String  @map("transaction_id")
  productId     String  @map("product_id")
  qty           Decimal @db.Decimal(14, 2)
  price         Decimal @db.Decimal(14, 2)

  transaction SalesTransaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  product     Product          @relation(fields: [productId], references: [id])

  @@index([transactionId])
  @@index([productId])
  @@map("sales_transaction_items")
}

model ChartOfAccount {
  id        String      @id @default(uuid())
  tenantId  String      @map("tenant_id")
  companyId String      @map("company_id")
  parentId  String?     @map("parent_id")
  code      String
  name      String
  type      AccountType

  tenant          Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  company         Company          @relation(fields: [tenantId, companyId], references: [tenantId, id], onDelete: Cascade)
  parent          ChartOfAccount?  @relation("AccountTree", fields: [tenantId, companyId, parentId], references: [tenantId, companyId, id], onDelete: Restrict)
  children        ChartOfAccount[] @relation("AccountTree")
  journalLines    JournalLine[]
  openingBalances OpeningBalance[]
  bankAccounts    BankAccount[]
  debitEntries    FinancialEntry[] @relation("FinancialDebitAccount")
  creditEntries   FinancialEntry[] @relation("FinancialCreditAccount")

  @@unique([companyId, code])
  @@unique([tenantId, companyId, id])
  @@index([tenantId, companyId, parentId])
  @@map("chart_of_accounts")
}

// JournalHeader + JournalLine menggantikan FinancialEntry sebagai ledger utama.
// FinancialEntry dipertahankan sementara sebagai compatibility mirror SBS.
model JournalHeader {
  id           String        @id @default(uuid())
  tenantId     String        @map("tenant_id")
  companyId    String        @map("company_id")
  number       String
  entryDate    DateTime      @map("entry_date")
  periodId     String        @map("period_id")
  status       JournalStatus @default(draft)
  memo         String        @default("")
  sourceModule String        @map("source_module")
  sourceRefId  String?       @map("source_ref_id")
  reversalOfId String?       @map("reversal_of_id")
  postedAt     DateTime?     @map("posted_at")
  postedById   String?       @map("posted_by_id")
  createdById  String?       @map("created_by_id")
  createdAt    DateTime      @default(now()) @map("created_at")

  tenant              Tenant                 @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  company             Company                @relation(fields: [tenantId, companyId], references: [tenantId, id], onDelete: Cascade)
  period              FiscalPeriod           @relation(fields: [tenantId, companyId, periodId], references: [tenantId, companyId, id], onDelete: Restrict)
  lines               JournalLine[]
  vendorBills         VendorBill[]
  vendorPayments      VendorPayment[]
  customerInvoices    CustomerInvoice[]
  customerReceipts    CustomerReceipt[]
  fixedAssets         FixedAsset[]
  depreciationEntries DepreciationSchedule[]
  payrollRuns         PayrollRun[]
  productionJournals  ProductionOrder[]
  reversalOf          JournalHeader?         @relation("JournalReversal", fields: [reversalOfId], references: [id], onDelete: SetNull)
  reversedBy          JournalHeader[]        @relation("JournalReversal")
  bankStatements      BankStatement[]        @relation("BankStatementJournal")

  @@unique([companyId, number])
  @@unique([tenantId, companyId, id])
  @@index([tenantId, companyId, entryDate])
  @@index([tenantId, companyId, status])
  @@index([companyId, sourceModule, sourceRefId])
  @@map("journal_headers")
}

model JournalLine {
  id           String           @id @default(uuid())
  tenantId     String           @map("tenant_id")
  companyId    String           @map("company_id")
  journalId    String           @map("journal_id")
  accountId    String           @map("account_id")
  lineNo       Int              @map("line_no")
  direction    JournalDirection
  amount       Decimal          @db.Decimal(14, 2)
  memo         String           @default("")
  partnerId    String?          @map("partner_id")
  projectId    String?          @map("project_id")
  costCenterId String?          @map("cost_center_id")

  journal JournalHeader  @relation(fields: [tenantId, companyId, journalId], references: [tenantId, companyId, id], onDelete: Cascade)
  account ChartOfAccount @relation(fields: [tenantId, companyId, accountId], references: [tenantId, companyId, id], onDelete: Restrict)

  @@unique([journalId, lineNo])
  @@index([tenantId, companyId, accountId])
  @@index([tenantId, companyId, partnerId])
  @@index([tenantId, companyId, projectId])
  @@map("journal_lines")
}

model JournalSequence {
  tenantId   String @map("tenant_id")
  companyId  String @map("company_id")
  periodKey  String @map("period_key") // YYYYMM
  lastNumber Int    @default(0) @map("last_number")

  company Company @relation(fields: [tenantId, companyId], references: [tenantId, id], onDelete: Cascade)

  @@id([tenantId, companyId, periodKey])
  @@map("journal_sequences")
}

model FiscalYear {
