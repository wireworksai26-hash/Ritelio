// Jurnal otomatis dari semua transaksi
model FinancialEntry {
  id               String   @id @default(uuid())
  tenantId         String   @map("tenant_id")
  companyId        String   @map("company_id")
  sourceModule     String   @map("source_module") // pos | inventory | finance
  sourceRefId      String   @map("source_ref_id")
  debitAccountId   String   @map("debit_account_id")
  creditAccountId  String   @map("credit_account_id")
  amount           Decimal  @db.Decimal(14, 2)
  entryDate        DateTime @map("entry_date")
  isAnomalyFlagged Boolean  @default(false) @map("is_anomaly_flagged")
  createdAt        DateTime @default(now()) @map("created_at")

  tenant        Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  company       Company        @relation(fields: [tenantId, companyId], references: [tenantId, id], onDelete: Cascade)
  debitAccount  ChartOfAccount @relation("FinancialDebitAccount", fields: [tenantId, companyId, debitAccountId], references: [tenantId, companyId, id], onDelete: Restrict)
  creditAccount ChartOfAccount @relation("FinancialCreditAccount", fields: [tenantId, companyId, creditAccountId], references: [tenantId, companyId, id], onDelete: Restrict)

  @@index([tenantId, entryDate])
  @@index([tenantId, isAnomalyFlagged])
  @@index([tenantId, sourceModule, sourceRefId])
  @@map("financial_entries")
}

// Semua output AI + feedback (explainability via based_on_refs)
